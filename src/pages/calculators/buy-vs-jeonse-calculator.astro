---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calculators } from '../../data/calculators';

const meta = calculators.find((c) => c.slug === 'buy-vs-jeonse-calculator')!;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`/calculators/${meta.slug}`}
>
  <h1>{meta.title}</h1>
  <p class="note">
    같은 보유현금으로 <strong>매매</strong>할 때와 <strong>전세</strong>로 살 때,
    일정 기간 후 실제로 얼마나 이득/손해를 보는지 비교합니다. 매매는 "집값
    상승분 − (취득세+중개수수료+대출이자+재산세+종부세)", 전세는 "여유자금
    운용수익 − 중개수수료"를 계산해서 두 값을 직접 비교합니다. 계산 결과의
    각 항목 옆에 실제 계산 공식을 함께 표시하니 어떻게 나온 숫자인지 바로
    확인할 수 있습니다.
  </p>

  <form class="calc-form" id="compare-form">
    <label>
      매매가 (원)
      <input
        type="number"
        id="purchasePrice"
        name="purchasePrice"
        min="0"
        step="any"
        placeholder="예: 600000000"
        required
      />
      <span class="amount-preview" id="purchasePrice-preview" aria-live="polite"></span>
    </label>

    <label>
      전세보증금 (원)
      <input
        type="number"
        id="jeonseDeposit"
        name="jeonseDeposit"
        min="0"
        step="any"
        placeholder="예: 400000000"
        required
      />
      <span class="amount-preview" id="jeonseDeposit-preview" aria-live="polite"></span>
    </label>

    <label>
      보유 현금(자기자본) (원)
      <span class="hint"
        >매매 시 매매가에 우선 투입하고 부족분을 대출로 조달합니다. 전세 시
        보증금을 뺀 나머지는 여유자금으로 운용한다고 가정합니다.</span
      >
      <input
        type="number"
        id="cashOnHand"
        name="cashOnHand"
        min="0"
        step="any"
        placeholder="예: 200000000"
        required
      />
      <span class="amount-preview" id="cashOnHand-preview" aria-live="polite"></span>
    </label>

    <label>
      비교(예상 거주) 기간 (년)
      <input
        type="number"
        id="years"
        name="years"
        min="1"
        step="1"
        placeholder="예: 5"
        required
      />
    </label>

    <label>
      대출 연이자율 (%)
      <input
        type="number"
        id="loanAnnualRatePercent"
        name="loanAnnualRatePercent"
        min="0"
        step="0.01"
        placeholder="예: 4.2"
        required
      />
    </label>

    <label>
      대출 기간 (년)
      <input
        type="number"
        id="loanTermYears"
        name="loanTermYears"
        min="1"
        step="1"
        placeholder="예: 30"
        required
      />
    </label>

    <label class="check-row">
      <input type="checkbox" id="isOver85Sqm" />
      <span>전용면적 85㎡ 초과 (취득세 농어촌특별세 부과 대상)</span>
    </label>

    <label class="check-row">
      <input type="checkbox" id="isUrbanArea" />
      <span>도시지역 내 소재 (재산세 도시지역분 추가 부과)</span>
    </label>

    <fieldset class="method-toggle">
      <legend>가정값 (기본값 사용 가능)</legend>
      <label>
        연간 집값 상승률 가정 (%)
        <input
          type="number"
          id="priceGrowthRatePercent"
          name="priceGrowthRatePercent"
          step="0.1"
          value="2"
        />
      </label>
      <label>
        여유자금 운용 연 수익률 가정 (%)
        <span class="hint"
          >보유현금 중 매매/전세에 쓰고 남는 돈(여유자금)을 이 수익률로
          운용한다고 가정합니다. 정기예금·안전자산 수준을 가정하세요.</span
        >
        <input
          type="number"
          id="investReturnRatePercent"
          name="investReturnRatePercent"
          step="0.1"
          value="3.5"
        />
      </label>
      <label>
        전세 재계약(2년 주기) 보증금 인상률 가정 (%)
        <span class="hint">법정 상한은 5%입니다.</span>
        <input
          type="number"
          id="jeonseRenewalIncreasePercent"
          name="jeonseRenewalIncreasePercent"
          step="0.1"
          value="5"
        />
      </label>
      <label>
        공시가격 ÷ 매매가 비율 가정 (%)
        <span class="hint">재산세 계산에 쓰이며, 통상 시세의 60~70% 수준입니다.</span>
        <input
          type="number"
          id="publicPriceRatioPercent"
          name="publicPriceRatioPercent"
          step="1"
          value="70"
        />
      </label>
    </fieldset>

    <button class="btn" type="submit">비교하기</button>
  </form>

  <p class="note" id="error-msg" role="alert"></p>

  <div class="result-box hidden" id="result" aria-live="polite">
    <div class="result-grid">
      <div class="result-item">
        <span class="label" id="verdict-label">더 유리한 선택</span>
        <span class="value"><span id="verdict-value">-</span></span>
      </div>
      <div class="result-item">
        <span class="label" id="diff-label">비용 차이</span>
        <span class="value"><span id="cost-difference">-</span></span>
      </div>
    </div>

    <p class="note">
      아래 "순비용"은 각 시나리오에서 실제로 나가는 돈(매매는 취득세·중개수수료·
      이자·재산세·종부세, 전세는 중개수수료)을 더한 뒤, 그 대가로 얻는
      이득(집값 상승분 또는 여유자금 운용수익)을 뺀 금액입니다. 이 값이
      작을수록(마이너스면 오히려 이득) 유리합니다.
    </p>

    <table class="breakdown">
      <caption class="note" style="text-align:left;margin-bottom:6px;">
        매매 시나리오
      </caption>
      <tbody>
        <tr>
          <td>대출금 <span class="hint">= 매매가 − 보유현금</span></td>
          <td id="buy-loan-amount">-</td>
        </tr>
        <tr>
          <td
            >취득세 등(1회) <span class="hint"
              >= 매매가 × 취득세율(1~3%) + 지방교육세(+농특세)</span
            ></td
          >
          <td id="buy-acquisition-tax">-</td>
        </tr>
        <tr>
          <td>중개수수료(1회) <span class="hint">= 매매가 × 중개보수 요율(구간별, 상한액 적용)</span></td>
          <td id="buy-brokerage-fee">-</td>
        </tr>
        <tr>
          <td
            >기간 내 대출이자 합계 <span class="hint"
              >= 대출금·연이자율 기준 원리금균등상환 스케줄의 비교기간분 이자 합</span
            ></td
          >
          <td id="buy-total-interest">-</td>
        </tr>
        <tr>
          <td
            >재산세 <span class="hint"
              >= 공시가격 × 공정시장가액비율 × 세율 (연 <span id="buy-annual-tax-hint"></span
              >)</span
            ></td
          >
          <td id="buy-total-property-tax">-</td>
        </tr>
        <tr id="buy-comprehensive-row" class="hidden">
          <td
            >종합부동산세 <span class="hint"
              >= (공시가격 − 12억) × 공정시장가액비율 × 세율 − 재산세액공제 (연
              <span id="buy-annual-comprehensive-hint"></span>, 1세대1주택 공제금액
              12억원 초과분)</span
            ></td
          >
          <td id="buy-total-comprehensive-tax">-</td>
        </tr>
        <tr id="buy-surplus-row" class="hidden">
          <td
            >잉여자금 운용 수익 <span class="hint"
              >= 잉여자금 × ((1+수익률)^년 − 1) (보유현금이 매매가보다 많을 때, 차감)</span
            ></td
          >
          <td id="buy-surplus-return">-</td>
        </tr>
        <tr>
          <td
            >예상 자본이득(집값 상승분) <span class="hint"
              >= 매매가 × ((1+집값상승률)^년 − 1) (차감)</span
            ></td
          >
          <td id="buy-capital-gain">-</td>
        </tr>
        <tr class="total">
          <td
            >매매 순비용 <span class="hint"
              >= 취득세 + 중개수수료 + 이자 + 재산세 + 종부세 − 자본이득 − 잉여자금
              수익</span
            ></td
          >
          <td id="buy-net-cost">-</td>
        </tr>
      </tbody>
    </table>

    <table class="breakdown">
      <caption class="note" style="text-align:left;margin-bottom:6px;">
        전세 시나리오
      </caption>
      <tbody>
        <tr>
          <td>중개수수료(1회) <span class="hint">= 보증금 × 중개보수 요율(구간별, 상한액 적용)</span></td>
          <td id="jeonse-brokerage-fee">-</td>
        </tr>
        <tr>
          <td
            >여유자금 <span class="hint"
              >= 보유현금 − 보증금 − 중개수수료</span
            ></td
          >
          <td id="jeonse-surplus-cash">-</td>
        </tr>
        <tr>
          <td>여유자금 운용 수익 <span class="hint">= 여유자금 × ((1+수익률)^년 − 1) (차감)</span></td>
          <td id="jeonse-surplus-return">-</td>
        </tr>
        <tr>
          <td
            >기간 종료 시 예상 보증금 <span class="hint"
              >= 보증금 × (1+재계약 인상률)^재계약횟수 (참고용, 순비용에 미반영 —
              보증금은 원금 그대로 돌려받으므로 계산에 들어가지 않음)</span
            ></td
          >
          <td id="jeonse-final-deposit">-</td>
        </tr>
        <tr class="total">
          <td>전세 순비용 <span class="hint">= 중개수수료 − 여유자금 운용 수익</span></td>
          <td id="jeonse-net-cost">-</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="disclaimer">
    본 계산 결과는 <strong>단순화된 추정치</strong>입니다. 재산세·종합부동산세는
    비교기간 내내 최초 공시가격 기준으로 동일하다고 가정하며(공시가격 상승
    미반영), 종합부동산세의 고령자·장기보유 세액공제·세부담상한, 중개보수
    협의가, 실제 대출 한도(DSR 등), 양도소득세는 반영하지 않았습니다.
    전세보증금이 보유 현금보다 큰 경우(전세자금대출이 필요한 상황)와 대출
    원금 상환분(현금이 그대로 집 지분으로 바뀌는 부분이라 순자산에
    중립적이라고 가정, 이자만 비용으로 집계)도 반영하지 않습니다. 실제
    의사결정 전 반드시 전문가와 상담하고 실제 금리·시세를 확인하세요.
  </div>

  <AdSlot />

  <section class="faq">
    <h2>자주 묻는 질문</h2>

    <details>
      <summary>실제 숫자로 어떻게 계산되는지 예시로 보여주세요</summary>
      <p>
        매매가 5억원, 전세보증금 3억원, 보유 현금 4억원, 비교기간 3년,
        대출금리 4%(20년), 집값 상승률 2%, 투자수익률 3%, 공시가격비율
        70%인 경우로 계산해 보겠습니다.
      </p>
      <p><strong>매매 시나리오</strong></p>
      <ul>
        <li>대출금 = 매매가 − 보유현금 = 5억 − 4억 = <strong>1억원</strong></li>
        <li>취득세 등(1회) = 5억 × 세율 ≈ <strong>550만원</strong></li>
        <li>중개수수료(1회) = 5억 × 중개보수 요율(구간별) ≈ <strong>200만원</strong></li>
        <li>3년간 대출이자 합계(1억, 4%, 20년 원리금균등 스케줄의 첫 36개월분) ≈ <strong>1,141만원</strong></li>
        <li>공시가격 = 5억 × 70% = 3.5억 → 재산세 연 15.4만원 × 3년 ≈ <strong>46만원</strong> (종부세는 3.5억 &lt; 12억이라 0원)</li>
        <li>여유자금 = 0원(보유현금 4억이 매매가 5억보다 적어 남는 돈 없음)</li>
        <li>예상 자본이득(차감) = 5억 × ((1.02)³ − 1) = 5억 × 6.12% ≈ <strong>3,060만원</strong></li>
        <li>매매 순비용 = 550 + 200 + 1,141 + 46 + 0 − 3,060 ≈ <strong>−1,124만원</strong> (마이너스면 오히려 이득)</li>
      </ul>
      <p><strong>전세 시나리오</strong></p>
      <ul>
        <li>중개수수료(1회) = 3억 × 중개보수 요율(구간별) ≈ <strong>90만원</strong></li>
        <li>여유자금 = 4억(보유현금) − 3억(보증금) − 90만원 ≈ <strong>9,910만원</strong></li>
        <li>여유자금 운용 수익(차감) = 9,910만원 × ((1.03)³ − 1) = 9,910만원 × 9.27% ≈ <strong>919만원</strong></li>
        <li>전세 순비용 = 90 − 919 ≈ <strong>−829만원</strong></li>
      </ul>
      <p>
        매매 순비용(−1,124만원)이 전세 순비용(−829만원)보다 작으므로(둘 다
        이득이지만 매매 쪽 이득이 더 큼), <strong>이 조건에서는 매매가 약
        295만원 더 유리</strong>합니다. 매매의 보유현금 4억원 전액이 집값
        상승(레버리지 포함 매매가 5억 전체에 대한 상승분)에 쓰이는 반면,
        전세는 보증금 3억원을 제외한 9,910만원만 실제로 투자되기 때문입니다.
        매매 쪽 중개수수료(200만원)가 전세 쪽(90만원)보다 크다는 점도 그
        격차를 줄이는 방향으로 작용합니다. 위 입력값을 그대로 넣어보시면
        결과 화면에서 이 숫자들을 그대로 확인할 수 있습니다.
      </p>
    </details>

    <details>
      <summary>종합부동산세도 반영되나요?</summary>
      <p>
        네. 공시가격(매매가 × 공시가격비율 가정)이 1세대 1주택 공제금액인
        12억원을 초과하면 종합부동산세가 자동으로 계산되어 매매 순비용에
        더해집니다(위 결과의 "종합부동산세" 항목이 이때만 표시됩니다).
        재산세로 이미 낸 부분을 다시 걷지 않도록 재산세액공제(이중과세
        조정)도 근사 반영했습니다. 다만 고령자·장기보유 세액공제와
        세부담상한은 반영하지 않아 실제보다 다소 높게 나올 수 있습니다 —
        정확한 금액은 <a href="/calculators/property-tax-calculator">보유세 계산기</a>에서
        별도로 확인하세요.
      </p>
    </details>

    <details>
      <summary>전세보증금은 왜 계산에 안 들어가나요?</summary>
      <p>
        전세보증금은 계약이 끝나면 이자 없이 원금 그대로 돌려받습니다.
        즉 보증금 자체는 그 기간 동안 늘지도 줄지도 않으므로, 두 시나리오를
        "실제로 얼마나 이득/손해를 봤는가"로 직접 비교할 때는 보증금
        금액 자체가 아니라 <strong>보증금을 빼고 남은 여유자금이 실제로
        얼마나 불어났는지</strong>만 비교하면 충분합니다. 매매의 자기자본도
        마찬가지로, 집값 상승분(자본이득)에 이미 그 돈의 성과가 반영되어
        있으므로 별도로 다시 계산하지 않습니다.
      </p>
    </details>

    <details>
      <summary>왜 매매는 자기자본이 아니라 매매가 전체의 상승분을 얻나요? (레버리지)</summary>
      <p>
        대출을 껴서 사더라도 집 전체를 소유하는 것이므로, 집값이 오르면
        대출금 비율과 무관하게 <strong>매매가 전체</strong>의 상승분을
        고스란히 얻습니다. 반대로 대출이자는 비용으로 그대로 부담합니다.
        그래서 자기자본 비율이 낮을수록(대출을 많이 낄수록) 오르는 만큼
        이득도, 이자 부담도 커지는 "레버리지" 효과가 그대로 드러납니다.
        이 계산기는 대출 원금 상환분 자체는 비용으로도 이득으로도 계산하지
        않습니다 — 현금이 그대로 내 집 지분으로 바뀔 뿐이라 순자산에는
        중립적이라고 보기 때문입니다.
      </p>
    </details>

    <details>
      <summary>투자수익률 가정을 바꾸면 결과가 많이 달라져요, 왜 그런가요?</summary>
      <p>
        투자수익률 가정은 <strong>여유자금</strong>(매매·전세에 쓰고 남는
        돈)에만 영향을 줍니다. 남는 돈이 거의 없는 조건(보유현금이 매매가나
        보증금과 비슷한 경우)에서는 투자수익률을 바꿔도 결과가 크게 안
        움직이지만, 보유현금이 넉넉해서 여유자금이 많이 남는 조건에서는
        그 여유자금을 어디에 넣어 굴리느냐(매매 쪽 잉여자금 vs 전세 쪽
        여유자금)에 따라 결과가 크게 달라질 수 있습니다. 두 시나리오의
        여유자금에는 항상 같은 수익률을 적용하므로, 특정 시나리오만 유리하게
        편향되지는 않습니다.
      </p>
    </details>

    <details>
      <summary>대출이자는 왜 "총 이자"가 아니라 "기간 내 이자"인가요?</summary>
      <p>
        대출기간(예: 30년) 전체의 총 이자가 아니라, 실제 비교하려는 보유기간(예:
        5년) 동안 상환하는 이자만 계산합니다. 원리금균등상환은 초기에 이자
        비중이 크므로, 짧은 보유기간을 비교할 때는 이 방식이 실제 부담에
        더 가깝습니다.
      </p>
    </details>

    <details>
      <summary>어떤 경우에 매매가 유리하고, 어떤 경우에 전세가 유리한가요?</summary>
      <p>
        집값 상승률 가정이 대출금리보다 충분히 높으면 레버리지 효과 덕분에
        매매가 유리해지는 경향이 있고, 반대로 집값이 정체·하락하거나
        대출금리가 높으면 이자 부담만 커지므로 전세가 유리해지는 경향이
        있습니다. 또한 보유현금이 넉넉해서 여유자금이 많이 남는 경우,
        투자수익률 가정을 높게 잡을수록 그 여유자금을 더 많이 굴릴 수 있는
        쪽(대개 전세 — 매매보다 필요한 초기 자금이 적기 때문)이 유리해지는
        경향이 있습니다. 가정값을 바꿔가며 여러 시나리오를 비교해 보세요.
      </p>
    </details>
  </section>
</BaseLayout>

<style>
  .faq ul {
    margin: 8px 0;
    padding-left: 20px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .faq li {
    margin: 4px 0;
  }
  .method-toggle label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    width: 100%;
  }
  .method-toggle input {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    width: 100%;
  }
</style>

<script>
  import { calculateBuyVsJeonse } from '../../lib/buyVsJeonseCalculator';
  import { formatKoreanWon } from '../../lib/formatKoreanWon';

  const form = document.getElementById('compare-form') as HTMLFormElement;
  const result = document.getElementById('result') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;

  const bindAmountPreview = (inputId: string, previewId: string) => {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const preview = document.getElementById(previewId) as HTMLSpanElement;
    input.addEventListener('input', () => {
      const value = Number(input.value);
      preview.textContent = value > 0 ? formatKoreanWon(value) : '';
    });
  };
  bindAmountPreview('purchasePrice', 'purchasePrice-preview');
  bindAmountPreview('jeonseDeposit', 'jeonseDeposit-preview');
  bindAmountPreview('cashOnHand', 'cashOnHand-preview');

  const won = new Intl.NumberFormat('ko-KR', {
    style: 'currency',
    currency: 'KRW',
    maximumFractionDigits: 0,
  });
  const setWon = (id: string, value: number) => {
    const el = document.getElementById(id);
    if (el) el.textContent = won.format(Math.round(value));
  };

  const getNum = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    errorMsg.textContent = '';

    const purchasePrice = getNum('purchasePrice');
    const jeonseDeposit = getNum('jeonseDeposit');
    const cashOnHand = getNum('cashOnHand');
    const years = getNum('years');
    const loanAnnualRatePercent = getNum('loanAnnualRatePercent');
    const loanTermYears = getNum('loanTermYears');

    if (!purchasePrice || purchasePrice <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = '매매가를 올바르게 입력해 주세요.';
      return;
    }
    if (!jeonseDeposit || jeonseDeposit <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = '전세보증금을 올바르게 입력해 주세요.';
      return;
    }
    if (!cashOnHand || cashOnHand <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = '보유 현금(자기자본)을 올바르게 입력해 주세요.';
      return;
    }
    if (!years || years < 1) {
      result.classList.add('hidden');
      errorMsg.textContent = '비교 기간을 올바르게 입력해 주세요.';
      return;
    }
    if (!loanAnnualRatePercent || loanAnnualRatePercent < 0) {
      result.classList.add('hidden');
      errorMsg.textContent = '대출 연이자율을 올바르게 입력해 주세요.';
      return;
    }
    if (!loanTermYears || loanTermYears < 1) {
      result.classList.add('hidden');
      errorMsg.textContent = '대출 기간을 올바르게 입력해 주세요.';
      return;
    }

    const r = calculateBuyVsJeonse({
      purchasePrice,
      jeonseDeposit,
      cashOnHand,
      years,
      loanAnnualRatePercent,
      loanTermYears,
      priceGrowthRatePercent: getNum('priceGrowthRatePercent'),
      investReturnRatePercent: getNum('investReturnRatePercent'),
      jeonseRenewalIncreasePercent: getNum('jeonseRenewalIncreasePercent'),
      publicPriceRatioPercent: getNum('publicPriceRatioPercent'),
      isOver85Sqm: (document.getElementById('isOver85Sqm') as HTMLInputElement).checked,
      isUrbanArea: (document.getElementById('isUrbanArea') as HTMLInputElement).checked,
    });

    const verdictValue = document.getElementById('verdict-value') as HTMLSpanElement;
    const diffLabel = document.getElementById('diff-label') as HTMLSpanElement;
    const costDifferenceEl = document.getElementById('cost-difference') as HTMLSpanElement;
    const diff = r.costDifference;
    if (diff > 0) {
      verdictValue.textContent = '전세';
      diffLabel.textContent = '매매보다 이만큼 저렴';
      costDifferenceEl.textContent = won.format(Math.round(diff));
    } else if (diff < 0) {
      verdictValue.textContent = '매매';
      diffLabel.textContent = '전세보다 이만큼 저렴';
      costDifferenceEl.textContent = won.format(Math.round(-diff));
    } else {
      verdictValue.textContent = '동일';
      diffLabel.textContent = '비용 차이';
      costDifferenceEl.textContent = '0원';
    }

    setWon('buy-loan-amount', r.buy.loanAmount);
    setWon('buy-acquisition-tax', r.buy.acquisitionTax);
    setWon('buy-brokerage-fee', r.buy.brokerageFee);
    setWon('buy-total-interest', r.buy.totalLoanInterest);
    setWon('buy-total-property-tax', r.buy.totalPropertyTax);
    (document.getElementById('buy-annual-tax-hint') as HTMLSpanElement).textContent = won.format(
      Math.round(r.buy.annualPropertyTax),
    );

    const comprehensiveRow = document.getElementById(
      'buy-comprehensive-row',
    ) as HTMLTableRowElement;
    comprehensiveRow.classList.toggle('hidden', r.buy.annualComprehensiveTax <= 0);
    if (r.buy.annualComprehensiveTax > 0) {
      setWon('buy-total-comprehensive-tax', r.buy.totalComprehensiveTax);
      (document.getElementById('buy-annual-comprehensive-hint') as HTMLSpanElement).textContent =
        won.format(Math.round(r.buy.annualComprehensiveTax));
    }
    const buySurplusRow = document.getElementById('buy-surplus-row') as HTMLTableRowElement;
    buySurplusRow.classList.toggle('hidden', r.buy.surplusCash <= 0);
    if (r.buy.surplusCash > 0) setWon('buy-surplus-return', r.buy.surplusInvestReturn);

    setWon('buy-capital-gain', r.buy.capitalGain);
    setWon('buy-net-cost', r.buy.netCost);

    setWon('jeonse-brokerage-fee', r.jeonse.brokerageFee);
    setWon('jeonse-surplus-cash', r.jeonse.surplusCash);
    setWon('jeonse-surplus-return', r.jeonse.surplusInvestReturn);
    setWon('jeonse-final-deposit', r.jeonse.expectedFinalDeposit);
    setWon('jeonse-net-cost', r.jeonse.netCost);

    result.classList.remove('hidden');
  });
</script>
