---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import { calculators, categoryOrder, categoryLabels } from '../data/calculators';

// 지금 시점에 화제성이 높은 계산기들을 홈 상단에 배너로 노출한다. 여러 개를
// 순환 노출하는 범용 추천 시스템이 아니라, 지금 이 계산기들만을 위한
// 하드코딩이다 — 필요해지면 그때 확장한다. 제목/설명은 calculators.ts를
// 그대로 재사용해 SSOT를 지킨다.
const featuredSlugs = ['comprehensive-tax-reform-calculator', 'capital-gains-tax-reform-calculator'];
const featuredCalculators = featuredSlugs
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined)
  .map((c) => {
    // 배너 제목이 좁은 화면에서 애매한 지점에 줄바꿈되지 않도록, "본제목
    // (부제)" 형태인 title을 괄호 앞에서 명시적으로 끊어 표시한다. title
    // 문자열 자체는 그대로 두고(SSOT — <title> 태그·카드 등 다른 곳은 원문
    // 그대로 씀) 이 배너에서만 표시 방식을 나눈다.
    const [titleMain, titleSub] = c.title.split(' (');
    return { ...c, titleMain, titleSub };
  });
---

<BaseLayout title="콤집계산기" path="/" lang="ko">
  <section class="intro">
    <h1>일상에 필요한 계산기 모음</h1>
    <p>
      월급 명세서를 확인할 때, 집을 살지 전세로 갈지 고민할 때, 투자 타이밍을
      잡을 때 — 그때그때 검색해서 여기저기 흩어진 계산기를 찾아다니는 대신,
      살면서 마주치는 돈 계산을 한곳에 모아뒀습니다. 회원가입도 설치도 없이
      브라우저에서 바로 계산하고, 다루는 영역도 계속 넓혀가고 있습니다.
    </p>
  </section>

  <div class="filter-bar">
    <select id="categorySelect" aria-label="카테고리 선택">
      <option value="전체">전체 카테고리</option>
      {categoryOrder.map((category) => <option value={category}>{categoryLabels[category].ko}</option>)}
    </select>
    <input
      type="search"
      id="searchInput"
      placeholder="계산기 이름으로 검색 (예: 취득세, 연봉, 물타기...)"
      aria-label="계산기 검색"
    />
  </div>

  {featuredCalculators.map((calculator) => (
    <a class="hot-banner" href={`/calculators/${calculator.slug}`}>
      <span class="hot-badge">🔥 지금 화제의 계산기</span>
      <h2>{calculator.titleMain}<br />({calculator.titleSub}</h2>
      <p>{calculator.description}</p>
    </a>
  ))}

  <p class="result-count" id="resultCount"></p>

  <div class="card-grid" id="grid">
    {calculators.map((calculator) => <CalculatorCard calculator={calculator} lang="ko" />)}
  </div>
  <p class="empty-state" id="emptyState">조건에 맞는 계산기가 없습니다. 검색어나 카테고리를 바꿔보세요.</p>
</BaseLayout>

<style>
  .hot-banner {
    display: block;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg));
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-top: 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .hot-banner:hover {
    border-color: var(--accent);
  }
  .hot-banner .hot-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent-dark);
    background: var(--bg-soft);
    border-radius: 5px;
    padding: 2px 8px;
    margin-bottom: 8px;
  }
  .hot-banner h2 {
    margin: 0 0 6px;
    font-size: 1.1rem;
    color: var(--accent-dark);
  }
  .hot-banner p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .intro h1 {
    font-size: 1.6rem;
    margin: 8px 0 12px;
  }
  .intro p {
    color: var(--text-muted);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .filter-bar select,
  .filter-bar input[type='search'] {
    font: inherit;
    /* iOS Safari auto-zooms on focus when a form control's font-size is
       below 16px — keep this at 1rem (not smaller) to avoid that. */
    font-size: 1rem;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .filter-bar select {
    flex: 0 0 auto;
    min-width: 132px;
    font-weight: 600;
    color: var(--accent-dark);
  }
  .filter-bar input[type='search'] {
    flex: 1 1 220px;
    min-width: 0;
  }
  .result-count {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .result-count strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .card-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-top: 12px;
  }
  .empty-state {
    display: none;
    padding: 40px 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .empty-state.show {
    display: block;
  }
  .card-grid.hidden-by-empty {
    display: none;
  }
</style>

<script>
  const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const grid = document.getElementById('grid') as HTMLDivElement;
  const resultCount = document.getElementById('resultCount') as HTMLParagraphElement;
  const emptyState = document.getElementById('emptyState') as HTMLParagraphElement;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.calc-card'));

  const render = () => {
    const category = categorySelect.value;
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory = category === '전체' || card.dataset.category === category;
      const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
      const visible = matchesCategory && matchesQuery;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    resultCount.innerHTML = `전체 <strong>${cards.length}</strong>개 중 <strong>${visibleCount}</strong>개 표시 중`;
    emptyState.classList.toggle('show', visibleCount === 0);
    grid.classList.toggle('hidden-by-empty', visibleCount === 0);
  };

  categorySelect.addEventListener('change', render);
  searchInput.addEventListener('input', render);
  render();
</script>
