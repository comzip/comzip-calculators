---

<BaseLayout
  title={meta.titleEn}
  description={meta.descriptionEn}
  path={`/calculators/${meta.slug}`}
  lang="en"
>
  <h1>{meta.titleEn}</h1>
  <p class="note">
    Calculates <strong>customs duty and VAT</strong> using the same items and
    rates as the Korea Customs Service's official
    <strong>"Estimated Tax for Overseas Purchases"</strong> calculator
    (including individual consumption tax, liquor tax, and education tax
    where applicable). Verified against 137 items and all tariff types
    (basic/EU FTA/US FTA) with matching live results.
  </p>

  <form class="calc-form" id="customs-form">
    <label>
      Item
      <select id="itemId">
        <option value="">Select an item</option>
        {
          categories.map((category) => (
            <optgroup label={categoryLabelsEn[category] ?? category}>
              {CUSTOMS_ITEMS.filter((item) => item.category === category).map((item) => (
                <option value={item.id}>{itemLabelsEn[item.id] ?? item.name}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>

    <label>
      Tariff type
      <select id="tariffKind">
        <option value="1">Basic tariff</option>
        <option value="4">Korea-EU FTA</option>
        <option value="5">Korea-US FTA</option>
      </select>
      <span class="hint"
        >If the item originates from the EU or US and meets the FTA
        rules-of-origin requirement, select the corresponding FTA rate;
        otherwise select the basic tariff.</span
      >
    </label>

    <label>
      Item price (US$)
      <span class="hint">Item price only, excluding international shipping/insurance. e.g. 220</span>
      <input
        type="number"
        id="priceUsd"
        name="priceUsd"
        min="0"
        step="any"
        placeholder="e.g. 220"
        required
      />
    </label>

    <label>
      Exchange rate (KRW per US$)
      <span class="hint">Use the Korea Customs Service's notified exchange rate. e.g. 1400</span>
      <input
        type="number"
        id="exchangeRate"
        name="exchangeRate"
        min="0"
        step="any"
        placeholder="e.g. 1400"
        required
      />
    </label>

    <button class="btn" type="submit">Calculate</button>
  </form>

  <p class="note" id="error-msg" role="alert"></p>

  <div class="result-box hidden" id="result" aria-live="polite">
    <div id="exempt-notice" class="disclaimer hidden">
      <strong>Below the duty-free threshold (~$150 equivalent) — customs duty and VAT are exempt.</strong>
      <span id="exempt-alcohol-note"></span>
    </div>

    <div class="result-grid">
      <div class="result-item">
        <span class="label">Estimated amount payable</span>
        <span class="value"><span id="display-total">-</span></span>
      </div>
    </div>

    <table class="breakdown" id="breakdown-table">
      <tbody>
        <tr>
          <td>Taxable price</td>
          <td id="cell-price">-</td>
        </tr>
        <tr id="row-tariff">
          <td>Customs duty <span class="hint" id="tariff-rate-hint"></span></td>
          <td id="cell-tariff">-</td>
        </tr>
        <tr id="row-consumption" class="hidden">
          <td>Individual consumption tax</td>
          <td id="cell-consumption">-</td>
        </tr>
        <tr id="row-liquor" class="hidden">
          <td>Liquor tax</td>
          <td id="cell-liquor">-</td>
        </tr>
        <tr id="row-agriculture" class="hidden">
          <td>Special rural development tax</td>
          <td id="cell-agriculture">-</td>
        </tr>
        <tr id="row-education" class="hidden">
          <td>Education tax</td>
          <td id="cell-education">-</td>
        </tr>
        <tr id="row-vat">
          <td>VAT</td>
          <td id="cell-vat">-</td>
        </tr>
        <tr class="total">
          <td>Sum of taxes <span class="hint">(before exemption)</span></td>
          <td id="cell-total">-</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="disclaimer">
    This result reproduces the logic of Korea Customs' official calculator as
    a <strong>simplified estimate</strong>. Actual tax depends on the exact HS
    classification of the item, the customs-notified exchange rate on the day
    of clearance, and whether personal-use quantity limits are exceeded.
    Korea Customs' official calculator applies a flat $150 duty-free
    threshold regardless of origin country or shipping method (it does not
    reflect the $200 express-courier exception that applies in some cases),
    and this calculator matches that behavior. Always confirm the actual
    amount payable with Korea Customs (call 125 within Korea) or a licensed
    customs broker.
  </div>

  <AdSlot lang="en" />

  <RelatedCalculators slug="customs-duty-calculator" lang="en" />

  <section class="faq">
    <h2>Frequently Asked Questions</h2>

    <details>
      <summary>Why is the threshold $150 even for US purchases?</summary>
      <p>
        Korea Customs' official "Estimated Tax for Overseas Purchases"
        calculator doesn't ask about the shipping method (e.g. express
        courier), so it always uses the $150 threshold regardless of origin
        country. In practice, a $200 threshold can apply under the Korea-US
        FTA specifically for goods shipped from the US via express courier —
        but since this calculator aims to reproduce the official calculator's
        results exactly, it uses the same $150 threshold.
      </p>
    </details>

    <details>
      <summary>How do I choose the tariff type?</summary>
      <p>
        If the item originates from the EU or US and you have proof of origin
        meeting the relevant FTA's rules of origin, you can select the
        preferential FTA rate (Korea-EU FTA or Korea-US FTA). Otherwise, or if
        you're unsure, select <strong>Basic tariff</strong>. Many items have a
        0% tariff rate under an applicable FTA.
      </p>
    </details>

    <details>
      <summary>Which items carry individual consumption tax, liquor tax, or education tax?</summary>
      <p>
        Luxury handbags and luxury wristwatches can only be calculated when
        the taxable price exceeds <strong>2,000,000 KRW</strong>, and
        individual consumption tax (20%) plus education tax (30% of that) only
        applies to the amount exceeding 2,000,000 KRW. Wine and sake carry a
        30% liquor tax; whisky and brandy carry a 72% liquor tax, plus
        education tax (10% of liquor tax for wine/sake, 30% for
        whisky/brandy). For these items, <strong>liquor tax always applies
        even under the $150 threshold</strong> (only customs duty and VAT are
        exempt).
      </p>
    </details>

    <details>
      <summary>How is VAT calculated?</summary>
      <p>
        VAT = (taxable price + customs duty + individual consumption tax +
        education tax + liquor tax + special rural development tax) × 10% —
        applied last, on top of every other tax combined.
      </p>
    </details>
  </section>
</BaseLayout>

<script>
  import { calculateCustomsDuty } from '../../../lib/customsDutyCalculator';
  import type { TariffKind } from '../../../lib/customsDutyCalculator';

  const form = document.getElementById('customs-form') as HTMLFormElement;
  const result = document.getElementById('result') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;
  const itemSelect = document.getElementById('itemId') as HTMLSelectElement;
  const kindSelect = document.getElementById('tariffKind') as HTMLSelectElement;

  const won = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'KRW',
    maximumFractionDigits: 0,
  });
  const setWon = (id: string, value: number) => {
    const el = document.getElementById(id);
    if (el) el.textContent = won.format(Math.round(value));
  };
  const showRow = (id: string, show: boolean) => {
    document.getElementById(id)?.classList.toggle('hidden', !show);
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    errorMsg.textContent = '';

    const itemId = Number(itemSelect.value);
    const tariffKind = Number(kindSelect.value) as TariffKind;
    const priceUsd = Number((document.getElementById('priceUsd') as HTMLInputElement).value);
    const exchangeRate = Number(
      (document.getElementById('exchangeRate') as HTMLInputElement).value,
    );

    if (!itemId) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please select an item.';
      return;
    }
    if (!priceUsd || priceUsd <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid item price.';
      return;
    }
    if (!exchangeRate || exchangeRate <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid exchange rate.';
      return;
    }

    const r = calculateCustomsDuty({ itemId, tariffKind, priceUsd, exchangeRate });

    if (r.error) {
      result.classList.add('hidden');
      errorMsg.textContent =
        'This item can only be calculated when the taxable price exceeds 2,000,000 KRW.';
      return;
    }

    setWon('cell-price', r.priceKrw);

    showRow('row-tariff', true);
    setWon('cell-tariff', r.tariff);
    (document.getElementById('tariff-rate-hint') as HTMLSpanElement).textContent =
      `(tariff rate ${r.tariffRate}%)`;

    showRow('row-consumption', r.consumptionTax > 0);
    if (r.consumptionTax > 0) setWon('cell-consumption', r.consumptionTax);

    showRow('row-liquor', r.liquorTax > 0);
    if (r.liquorTax > 0) setWon('cell-liquor', r.liquorTax);

    showRow('row-agriculture', r.agricultureTax > 0);
    if (r.agricultureTax > 0) setWon('cell-agriculture', r.agricultureTax);

    showRow('row-education', r.educationTax > 0);
    if (r.educationTax > 0) setWon('cell-education', r.educationTax);

    setWon('cell-vat', r.vat);
    setWon('cell-total', r.total);
    setWon('display-total', r.displayTotal);

    const exemptNotice = document.getElementById('exempt-notice') as HTMLDivElement;
    exemptNotice.classList.toggle('hidden', !r.isBelowExemption);
    if (r.isBelowExemption) {
      const alcoholNote = document.getElementById('exempt-alcohol-note') as HTMLSpanElement;
      alcoholNote.textContent = r.isAlcohol
        ? ' Alcohol still owes liquor tax even under the threshold, so it is included in the estimated amount payable.'
        : '';
    }

    result.classList.remove('hidden');
  });
</script>
