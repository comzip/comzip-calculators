---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { calculators } from '../../../data/calculators';

const meta = calculators.find((c) => c.slug === 'buy-vs-jeonse-calculator')!;
---

<BaseLayout
  title={meta.titleEn}
  description={meta.descriptionEn}
  path={`/calculators/${meta.slug}`}
  lang="en"
>
  <h1>{meta.titleEn}</h1>
  <p class="note">
    Compares <strong>buying</strong> a home versus renting under
    <strong>jeonse</strong> (Korea's lump-sum deposit lease), starting from
    the same cash on hand, by directly comparing what that cash actually
    becomes (<strong>final capital</strong>) by the end of the holding
    period. Buying is "cash on hand + appreciation + surplus-cash return −
    acquisition tax − brokerage fee − loan interest − property tax −
    comprehensive real estate tax"; jeonse is "cash on hand + surplus-cash
    return − brokerage fee." Every line item in the results below shows the
    exact formula used, so you can see how each figure was derived.
  </p>

  <form class="calc-form" id="compare-form">
    <label>
      Purchase price (KRW)
      <input
        type="number"
        id="purchasePrice"
        name="purchasePrice"
        min="0"
        step="any"
        placeholder="e.g. 600000000"
        required
      />
      <span class="amount-preview" id="purchasePrice-preview" aria-live="polite"></span>
    </label>

    <label>
      Jeonse deposit (KRW)
      <input
        type="number"
        id="jeonseDeposit"
        name="jeonseDeposit"
        min="0"
        step="any"
        placeholder="e.g. 400000000"
        required
      />
      <span class="amount-preview" id="jeonseDeposit-preview" aria-live="polite"></span>
    </label>

    <label>
      Cash on hand (KRW)
      <span class="hint"
        >For buying, this goes toward the purchase price first, and the
        shortfall is financed with a loan. For jeonse, whatever's left after
        the deposit is assumed to be invested as surplus cash.</span
      >
      <input
        type="number"
        id="cashOnHand"
        name="cashOnHand"
        min="0"
        step="any"
        placeholder="e.g. 200000000"
        required
      />
      <span class="amount-preview" id="cashOnHand-preview" aria-live="polite"></span>
    </label>

    <label>
      Comparison (expected residence) period (years)
      <input
        type="number"
        id="years"
        name="years"
        min="1"
        step="1"
        placeholder="e.g. 5"
        required
      />
    </label>

    <label>
      Loan annual interest rate (%)
      <input
        type="number"
        id="loanAnnualRatePercent"
        name="loanAnnualRatePercent"
        min="0"
        step="0.01"
        placeholder="e.g. 4.2"
        required
      />
    </label>

    <label>
      Loan term (years)
      <input
        type="number"
        id="loanTermYears"
        name="loanTermYears"
        min="1"
        step="1"
        placeholder="e.g. 30"
        required
      />
    </label>

    <label class="check-row">
      <input type="checkbox" id="isOver85Sqm" />
      <span>Exclusive area over 85㎡ (subject to acquisition tax's special rural development tax)</span>
    </label>

    <label class="check-row">
      <input type="checkbox" id="isUrbanArea" />
      <span>Located in an urban area (subject to property tax's urban area surtax)</span>
    </label>

    <fieldset class="method-toggle">
      <legend>Assumptions (defaults provided)</legend>
      <label>
        Annual home price growth assumption (%)
        <input
          type="number"
          id="priceGrowthRatePercent"
          name="priceGrowthRatePercent"
          step="0.1"
          value="2"
        />
      </label>
      <label>
        Annual return assumption for surplus cash (%)
        <span class="hint"
          >Whatever cash is left over after buying or the jeonse deposit is
          assumed to be invested at this rate. Use a safe-asset level such as
          a term deposit.</span
        >
        <input
          type="number"
          id="investReturnRatePercent"
          name="investReturnRatePercent"
          step="0.1"
          value="3.5"
        />
      </label>
      <label>
        Jeonse renewal (2-year cycle) deposit increase assumption (%)
        <span class="hint">The statutory cap is 5%.</span>
        <input
          type="number"
          id="jeonseRenewalIncreasePercent"
          name="jeonseRenewalIncreasePercent"
          step="0.1"
          value="5"
        />
      </label>
      <label>
        Announced value ÷ purchase price ratio assumption (%)
        <span class="hint">Used for the property tax calculation; typically 60–70% of market price.</span>
        <input
          type="number"
          id="publicPriceRatioPercent"
          name="publicPriceRatioPercent"
          step="1"
          value="70"
        />
      </label>
    </fieldset>

    <button class="btn" type="submit">Compare</button>
  </form>

  <p class="note" id="error-msg" role="alert"></p>

  <div class="result-box hidden" id="result" aria-live="polite">
    <div class="result-grid">
      <div class="result-item">
        <span class="label" id="verdict-label">Better option</span>
        <span class="value"><span id="verdict-value">-</span></span>
      </div>
      <div class="result-item">
        <span class="label" id="diff-label">Final capital difference</span>
        <span class="value"><span id="cost-difference">-</span></span>
      </div>
    </div>

    <div class="result-grid">
      <div class="result-item">
        <span class="label">Final capital if buying</span>
        <span class="value"><span id="buy-final-capital-headline">-</span></span>
      </div>
      <div class="result-item">
        <span class="label">Final capital if jeonse</span>
        <span class="value"><span id="jeonse-final-capital-headline">-</span></span>
      </div>
    </div>

    <p class="note">
      The table below starts from your <strong>starting capital (cash on
      hand)</strong> and adds what actually grows it (<span class="plus"
      >+</span>) and subtracts what actually leaves your pocket (<span
      class="minus">−</span>) in each scenario, arriving at the
      <strong>final capital</strong> at the end of the comparison period. A
      larger final capital is better.
    </p>

    <table class="breakdown">
      <caption class="note" style="text-align:left;margin-bottom:6px;">
        Buying scenario
      </caption>
      <tbody>
        <tr>
          <td>Starting capital (cash on hand)</td>
          <td id="buy-starting-cash">-</td>
        </tr>
        <tr>
          <td>
            Loan amount <span class="hint">(reference only, not directly part of final capital)</span>
            <span class="formula-line">= purchase price − cash on hand</span>
            <span class="formula-actual" id="buy-loan-amount-formula">-</span>
          </td>
          <td id="buy-loan-amount">-</td>
        </tr>
        <tr>
          <td>
            Acquisition tax etc. (one-time)
            <span class="formula-line">= base tax + local education tax + rural development tax</span>
            <span class="formula-actual" id="buy-acquisition-tax-formula">-</span>
          </td>
          <td class="amount-minus" id="buy-acquisition-tax">-</td>
        </tr>
        <tr>
          <td>
            Brokerage fee (one-time)
            <span class="formula-line">= purchase price × capped brokerage rate (bracketed)</span>
            <span class="formula-actual" id="buy-brokerage-fee-formula">-</span>
          </td>
          <td class="amount-minus" id="buy-brokerage-fee">-</td>
        </tr>
        <tr>
          <td>
            Loan interest paid over the period
            <span class="formula-line">= equal-payment amortization(loan amount, annual rate, loan term) schedule's interest over the comparison period</span>
            <span class="formula-actual" id="buy-total-interest-formula">-</span>
          </td>
          <td class="amount-minus" id="buy-total-interest">-</td>
        </tr>
        <tr>
          <td>
            Property tax
            <span class="formula-line">= (base tax + local education tax + urban area surtax) × comparison period</span>
            <span class="formula-actual" id="buy-total-property-tax-formula">-</span>
          </td>
          <td class="amount-minus" id="buy-total-property-tax">-</td>
        </tr>
        <tr id="buy-comprehensive-row" class="hidden">
          <td>
            Comprehensive real estate tax <span class="hint">(on the amount exceeding the 1.2B KRW single-home deduction)</span>
            <span class="formula-line">= (calculated tax − property tax credit) × 1.2 (incl. surtax) × comparison period</span>
            <span class="formula-actual" id="buy-total-comprehensive-tax-formula">-</span>
          </td>
          <td class="amount-minus" id="buy-total-comprehensive-tax">-</td>
        </tr>
        <tr id="buy-surplus-row" class="hidden">
          <td>
            Surplus cash investment return <span class="hint">(when cash on hand exceeds the purchase price)</span>
            <span class="formula-line">= surplus cash × ((1+return rate)^years − 1)</span>
            <span class="formula-actual" id="buy-surplus-return-formula">-</span>
          </td>
          <td class="amount-plus" id="buy-surplus-return">-</td>
        </tr>
        <tr>
          <td>
            Expected capital gain (appreciation)
            <span class="formula-line">= purchase price × ((1+growth rate)^years − 1)</span>
            <span class="formula-actual" id="buy-capital-gain-formula">-</span>
          </td>
          <td class="amount-plus" id="buy-capital-gain">-</td>
        </tr>
        <tr class="total">
          <td>
            Final capital if buying
            <span class="formula-line">= starting capital + capital gain + surplus cash return − acquisition tax − brokerage fee − interest − property tax − comprehensive real estate tax</span>
            <span class="formula-actual" id="buy-final-capital-formula">-</span>
          </td>
          <td id="buy-final-capital">-</td>
        </tr>
      </tbody>
    </table>

    <table class="breakdown">
      <caption class="note" style="text-align:left;margin-bottom:6px;">
        Jeonse scenario
      </caption>
      <tbody>
        <tr>
          <td>Starting capital (cash on hand)</td>
          <td id="jeonse-starting-cash">-</td>
        </tr>
        <tr>
          <td>
            Brokerage fee (one-time)
            <span class="formula-line">= deposit × capped brokerage rate (bracketed)</span>
            <span class="formula-actual" id="jeonse-brokerage-fee-formula">-</span>
          </td>
          <td class="amount-minus" id="jeonse-brokerage-fee">-</td>
        </tr>
        <tr>
          <td>
            Surplus cash <span class="hint">(reference only, not directly part of final capital)</span>
            <span class="formula-line">= cash on hand − deposit − brokerage fee</span>
            <span class="formula-actual" id="jeonse-surplus-cash-formula">-</span>
          </td>
          <td id="jeonse-surplus-cash">-</td>
        </tr>
        <tr>
          <td>
            Surplus cash investment return
            <span class="formula-line">= surplus cash × ((1+return rate)^years − 1)</span>
            <span class="formula-actual" id="jeonse-surplus-return-formula">-</span>
          </td>
          <td class="amount-plus" id="jeonse-surplus-return">-</td>
        </tr>
        <tr>
          <td>
            Expected deposit at period end
            <span class="hint">(reference only — the deposit is returned at face value, so it stays in your starting capital unchanged and isn't added separately to final capital)</span>
            <span class="formula-line">= deposit × (1+renewal increase rate)^renewal cycles</span>
            <span class="formula-actual" id="jeonse-final-deposit-formula">-</span>
          </td>
          <td id="jeonse-final-deposit">-</td>
        </tr>
        <tr class="total">
          <td>
            Final capital if jeonse
            <span class="formula-line">= starting capital + surplus cash return − brokerage fee</span>
            <span class="formula-actual" id="jeonse-final-capital-formula">-</span>
          </td>
          <td id="jeonse-final-capital">-</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="disclaimer">
    This result is a <strong>simplified estimate</strong>. Property tax and
    comprehensive real estate tax are assumed constant at the initial
    announced value throughout the comparison period (appreciation of the
    announced value is not reflected), and comprehensive real estate tax's
    senior/long-term-holding credits and tax burden cap, negotiated brokerage
    rates, actual loan limits (e.g. DSR), and capital gains tax on resale are
    not included. A jeonse deposit larger than the cash on hand (which would
    require a jeonse loan), and the loan's principal repayment (only
    interest is counted as a cost, since principal converts cash into home
    equity and is treated as net-worth-neutral), are also not modeled.
    Always consult a professional and confirm actual rates and market prices
    before making a real decision.
  </div>

  <AdSlot lang="en" />

  <section class="faq">
    <h2>Frequently Asked Questions</h2>

    <details>
      <summary>Can you show a worked example with real numbers?</summary>
      <p>
        Let's calculate with: purchase price 500M KRW, jeonse deposit 300M
        KRW, cash on hand 400M KRW, a 3-year comparison period, a 4% loan
        rate over 20 years, 2% home price growth, 3% investment return, and
        a 70% announced-value ratio.
      </p>
      <p><strong>Buying scenario</strong></p>
      <ul>
        <li>Starting capital (cash on hand) = <strong>400M KRW</strong></li>
        <li>Loan amount (reference) = purchase price − cash on hand = 500M − 400M = <strong>100M KRW</strong></li>
        <li>Acquisition tax etc. (one-time) = 500M × tax rate ≈ <strong>−5.5M KRW</strong></li>
        <li>Brokerage fee (one-time) = 500M × brokerage rate (bracketed) ≈ <strong>−2M KRW</strong></li>
        <li>Interest over 3 years (first 36 months of a 100M/4%/20yr equal-payment schedule) ≈ <strong>−11.4M KRW</strong></li>
        <li>Announced value = 500M × 70% = 350M → property tax ≈ 1.536M/yr × 3yr ≈ <strong>−4.6M KRW</strong> (comprehensive tax is 0 since 350M &lt; 1.2B)</li>
        <li>Surplus cash = 0 (cash on hand 400M is less than the 500M purchase price, so nothing is left over) → surplus return is also 0</li>
        <li>Expected capital gain (appreciation) = 500M × ((1.02)³ − 1) = 500M × 6.12% ≈ <strong>+30.6M KRW</strong></li>
        <li>Final capital if buying = 400 − 5.5 − 2 − 11.4 − 4.6 + 0 + 30.6M ≈ <strong>411.2M KRW</strong></li>
      </ul>
      <p><strong>Jeonse scenario</strong></p>
      <ul>
        <li>Starting capital (cash on hand) = <strong>400M KRW</strong></li>
        <li>Brokerage fee (one-time) = 300M × brokerage rate (bracketed) ≈ <strong>−0.9M KRW</strong></li>
        <li>Surplus cash (reference) = 400M (cash on hand) − 300M (deposit) − 0.9M ≈ <strong>99.1M KRW</strong></li>
        <li>Surplus cash investment return = 99.1M × ((1.03)³ − 1) = 99.1M × 9.27% ≈ <strong>+9.2M KRW</strong></li>
        <li>Final capital if jeonse = 400 − 0.9 + 9.2M ≈ <strong>408.3M KRW</strong></li>
      </ul>
      <p>
        Buying's final capital (411.2M) is higher than jeonse's (408.3M) —
        so <strong>under these conditions buying leaves you about 2.9M KRW
        better off</strong>. All 400M KRW of the buyer's cash works toward
        appreciation on the full 500M home (leverage), while the renter only
        actually invests 99.1M KRW (the rest sits in the deposit, earning
        nothing). Buying's brokerage fee (2M) is also larger than jeonse's
        (0.9M), which narrows the gap. Enter these same inputs above and
        you'll see these exact figures in the results.
      </p>
    </details>

    <details>
      <summary>Is comprehensive real estate tax included?</summary>
      <p>
        Yes. If the announced value (purchase price × your announced-value
        ratio assumption) exceeds the 1.2 billion KRW single-home deduction,
        comprehensive real estate tax is calculated automatically and
        subtracted from the final capital if buying (the "Comprehensive real
        estate tax" row above only appears in that case). It also
        approximates the property
        tax credit so tax already paid via property tax isn't double-counted.
        Senior/long-term-holding credits and the tax burden cap aren't
        reflected, though, so the real amount may be somewhat lower — check
        the exact figure with the
        <a href="/en/calculators/property-tax-calculator">property holding tax calculator</a>.
      </p>
    </details>

    <details>
      <summary>Why doesn't the jeonse deposit itself appear in the calculation?</summary>
      <p>
        A jeonse deposit is returned in full, with no interest, when the
        lease ends — so the deposit itself neither grows nor shrinks over
        the period. When comparing how much each scenario actually gains or
        loses, all that matters is <strong>how much the leftover surplus
        cash (after setting aside the deposit) actually grew</strong>. The
        buyer's cash on hand works the same way — its performance already
        shows up fully in the capital gain, so it isn't counted a second
        time.
      </p>
    </details>

    <details>
      <summary>Why does buying capture the full purchase price's appreciation instead of just the equity's? (Leverage)</summary>
      <p>
        Even with a loan, you own the entire home — so when its value rises,
        you capture the appreciation on the <strong>full purchase
        price</strong>, regardless of how much was financed. In exchange,
        you bear the loan interest as a real cost. That means a smaller
        equity share (more leverage) amplifies both the potential gain and
        the interest burden. This calculator doesn't count loan principal
        repayment as a cost or a gain either way — it converts cash directly
        into home equity, so it's treated as net-worth-neutral.
      </p>
    </details>

    <details>
      <summary>Changing the return assumption swings the result a lot — why?</summary>
      <p>
        The return assumption only affects <strong>surplus cash</strong> —
        whatever's left over after buying or after the jeonse deposit. When
        there's little or no surplus in either scenario (cash on hand close
        to the purchase price or deposit), changing this assumption barely
        moves the result. But when cash on hand is large relative to the
        purchase price or deposit, a lot of surplus cash is left in play,
        and where that surplus does better (buying's leftover cash vs.
        jeonse's leftover cash) can swing the comparison substantially. The
        same rate is always applied to both scenarios' surplus cash, so
        neither side is unfairly favored.
      </p>
    </details>

    <details>
      <summary>Why "interest over the period" instead of the loan's total interest?</summary>
      <p>
        Rather than the total interest over the entire loan term (e.g. 30
        years), this only counts the interest paid during the actual holding
        period you're comparing (e.g. 5 years). Since equal-payment
        amortization front-loads interest, this better reflects the real
        burden for a shorter holding period.
      </p>
    </details>

    <details>
      <summary>When does buying win, and when does jeonse win?</summary>
      <p>
        If your assumed price growth rate is comfortably above the loan
        rate, buying tends to win thanks to leverage. If home prices are
        expected to stagnate or decline, or the loan rate is high, the
        interest burden dominates and jeonse tends to win. When cash on hand
        is large enough to leave significant surplus cash, a higher return
        assumption tends to favor jeonse — since buying generally requires
        more upfront cash, jeonse usually leaves more surplus cash to invest.
        Try adjusting the assumptions to compare different scenarios.
      </p>
    </details>
  </section>
</BaseLayout>

<style>
  .faq ul {
    margin: 8px 0;
    padding-left: 20px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .faq li {
    margin: 4px 0;
  }
  .method-toggle label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    width: 100%;
  }
  .method-toggle input {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    width: 100%;
  }
  table.breakdown .hint,
  table.breakdown .formula-line,
  table.breakdown .formula-actual {
    display: block;
    font-weight: 400;
    color: var(--text-muted);
  }
  table.breakdown .hint {
    font-size: 0.85rem;
    margin-top: 2px;
  }
  table.breakdown .formula-line,
  table.breakdown .formula-actual {
    font-size: 0.78rem;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  table.breakdown td.amount-minus,
  table.breakdown td.amount-plus {
    font-weight: 600;
    white-space: nowrap;
  }
  table.breakdown td.amount-minus {
    color: #b91c1c;
  }
  table.breakdown td.amount-plus {
    color: #15803d;
  }
  .plus {
    color: #15803d;
    font-weight: 700;
  }
  .minus {
    color: #b91c1c;
    font-weight: 700;
  }
</style>

<script>
  import { calculateBuyVsJeonse } from '../../../lib/buyVsJeonseCalculator';
  import { formatWonEn } from '../../../lib/formatKoreanWon';

  const form = document.getElementById('compare-form') as HTMLFormElement;
  const result = document.getElementById('result') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;

  const bindAmountPreview = (inputId: string, previewId: string) => {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const preview = document.getElementById(previewId) as HTMLSpanElement;
    input.addEventListener('input', () => {
      const value = Number(input.value);
      preview.textContent = value > 0 ? formatWonEn(value) : '';
    });
  };
  bindAmountPreview('purchasePrice', 'purchasePrice-preview');
  bindAmountPreview('jeonseDeposit', 'jeonseDeposit-preview');
  bindAmountPreview('cashOnHand', 'cashOnHand-preview');

  const won = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'KRW',
    maximumFractionDigits: 0,
  });
  const setWon = (id: string, value: number) => {
    const el = document.getElementById(id);
    if (el) el.textContent = won.format(Math.round(value));
  };
  const setSignedWon = (id: string, value: number, sign: '+' | '−') => {
    const el = document.getElementById(id);
    if (el) el.textContent = `${sign}${won.format(Math.round(value))}`;
  };
  const setText = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };
  const fmtPct = (value: number) => `${Number(value.toFixed(2))}%`;

  const getNum = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    errorMsg.textContent = '';

    const purchasePrice = getNum('purchasePrice');
    const jeonseDeposit = getNum('jeonseDeposit');
    const cashOnHand = getNum('cashOnHand');
    const years = getNum('years');
    const loanAnnualRatePercent = getNum('loanAnnualRatePercent');
    const loanTermYears = getNum('loanTermYears');

    if (!purchasePrice || purchasePrice <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid purchase price.';
      return;
    }
    if (!jeonseDeposit || jeonseDeposit <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid jeonse deposit.';
      return;
    }
    if (!cashOnHand || cashOnHand <= 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter valid cash on hand.';
      return;
    }
    if (!years || years < 1) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid comparison period.';
      return;
    }
    if (!loanAnnualRatePercent || loanAnnualRatePercent < 0) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid loan interest rate.';
      return;
    }
    if (!loanTermYears || loanTermYears < 1) {
      result.classList.add('hidden');
      errorMsg.textContent = 'Please enter a valid loan term.';
      return;
    }

    const priceGrowthRatePercent = getNum('priceGrowthRatePercent');
    const investReturnRatePercent = getNum('investReturnRatePercent');
    const jeonseRenewalIncreasePercent = getNum('jeonseRenewalIncreasePercent');

    const r = calculateBuyVsJeonse({
      purchasePrice,
      jeonseDeposit,
      cashOnHand,
      years,
      loanAnnualRatePercent,
      loanTermYears,
      priceGrowthRatePercent,
      investReturnRatePercent,
      jeonseRenewalIncreasePercent,
      publicPriceRatioPercent: getNum('publicPriceRatioPercent'),
      isOver85Sqm: (document.getElementById('isOver85Sqm') as HTMLInputElement).checked,
      isUrbanArea: (document.getElementById('isUrbanArea') as HTMLInputElement).checked,
    });

    const verdictValue = document.getElementById('verdict-value') as HTMLSpanElement;
    const diffLabel = document.getElementById('diff-label') as HTMLSpanElement;
    const costDifferenceEl = document.getElementById('cost-difference') as HTMLSpanElement;
    const diff = r.capitalDifference;
    if (diff > 0) {
      verdictValue.textContent = 'Buying';
      diffLabel.textContent = 'More final capital than jeonse, by';
      costDifferenceEl.textContent = won.format(Math.round(diff));
    } else if (diff < 0) {
      verdictValue.textContent = 'Jeonse';
      diffLabel.textContent = 'More final capital than buying, by';
      costDifferenceEl.textContent = won.format(Math.round(-diff));
    } else {
      verdictValue.textContent = 'Tie';
      diffLabel.textContent = 'Final capital difference';
      costDifferenceEl.textContent = '₩0';
    }

    setWon('buy-final-capital-headline', r.buy.finalCapital);
    setWon('jeonse-final-capital-headline', r.jeonse.finalCapital);

    setWon('buy-starting-cash', r.buy.startingCash);

    setWon('buy-loan-amount', r.buy.loanAmount);
    setText('buy-loan-amount-formula', `= ${won.format(purchasePrice)} − ${won.format(cashOnHand)}`);

    setSignedWon('buy-acquisition-tax', r.buy.acquisitionTax, '−');
    setText(
      'buy-acquisition-tax-formula',
      `= ${won.format(r.buy.acquisitionTaxBase)} + ${won.format(r.buy.acquisitionLocalEduTax)} + ${won.format(r.buy.acquisitionRuralTax)}`,
    );

    setSignedWon('buy-brokerage-fee', r.buy.brokerageFee, '−');
    const buyRawBrokerageFee = purchasePrice * r.buy.brokerageRatePercent;
    setText(
      'buy-brokerage-fee-formula',
      r.buy.brokerageLimit !== undefined && buyRawBrokerageFee > r.buy.brokerageLimit
        ? `= capped at ${won.format(r.buy.brokerageLimit)}`
        : `= ${won.format(purchasePrice)} × ${fmtPct(r.buy.brokerageRatePercent * 100)}`,
    );

    setSignedWon('buy-total-interest', r.buy.totalLoanInterest, '−');
    setText(
      'buy-total-interest-formula',
      `= equal-payment amortization(${won.format(r.buy.loanAmount)}, ${fmtPct(loanAnnualRatePercent)}, ${loanTermYears}yr) schedule's first ${r.buy.interestMonthsCounted} months of interest`,
    );

    setSignedWon('buy-total-property-tax', r.buy.totalPropertyTax, '−');
    setText(
      'buy-total-property-tax-formula',
      `= (${won.format(r.buy.annualPropertyTaxBase)} + ${won.format(r.buy.annualPropertyLocalEduTax)} + ${won.format(r.buy.annualPropertyUrbanAreaTax)}) × ${years}yr`,
    );

    const comprehensiveRow = document.getElementById(
      'buy-comprehensive-row',
    ) as HTMLTableRowElement;
    comprehensiveRow.classList.toggle('hidden', r.buy.annualComprehensiveTax <= 0);
    if (r.buy.annualComprehensiveTax > 0) {
      setSignedWon('buy-total-comprehensive-tax', r.buy.totalComprehensiveTax, '−');
      setText(
        'buy-total-comprehensive-tax-formula',
        `= (${won.format(r.buy.annualComprehensiveCalculatedTax)} − ${won.format(r.buy.annualComprehensivePropertyCredit)}) × 1.2 × ${years}yr`,
      );
    }

    const buySurplusRow = document.getElementById('buy-surplus-row') as HTMLTableRowElement;
    buySurplusRow.classList.toggle('hidden', r.buy.surplusCash <= 0);
    if (r.buy.surplusCash > 0) {
      setSignedWon('buy-surplus-return', r.buy.surplusInvestReturn, '+');
      setText(
        'buy-surplus-return-formula',
        `= ${won.format(r.buy.surplusCash)} × ((1+${fmtPct(investReturnRatePercent)})^${years} − 1)`,
      );
    }

    setSignedWon('buy-capital-gain', r.buy.capitalGain, '+');
    setText(
      'buy-capital-gain-formula',
      `= ${won.format(purchasePrice)} × ((1+${fmtPct(priceGrowthRatePercent)})^${years} − 1)`,
    );

    setWon('buy-final-capital', r.buy.finalCapital);
    setText(
      'buy-final-capital-formula',
      `= ${won.format(r.buy.startingCash)} + ${won.format(r.buy.capitalGain)} + ${won.format(r.buy.surplusInvestReturn)} − ${won.format(r.buy.acquisitionTax)} − ${won.format(r.buy.brokerageFee)} − ${won.format(r.buy.totalLoanInterest)} − ${won.format(r.buy.totalPropertyTax)} − ${won.format(r.buy.totalComprehensiveTax)}`,
    );

    setWon('jeonse-starting-cash', r.jeonse.startingCash);

    setSignedWon('jeonse-brokerage-fee', r.jeonse.brokerageFee, '−');
    const jeonseRawBrokerageFee = jeonseDeposit * r.jeonse.brokerageRatePercent;
    setText(
      'jeonse-brokerage-fee-formula',
      r.jeonse.brokerageLimit !== undefined && jeonseRawBrokerageFee > r.jeonse.brokerageLimit
        ? `= capped at ${won.format(r.jeonse.brokerageLimit)}`
        : `= ${won.format(jeonseDeposit)} × ${fmtPct(r.jeonse.brokerageRatePercent * 100)}`,
    );

    setWon('jeonse-surplus-cash', r.jeonse.surplusCash);
    setText(
      'jeonse-surplus-cash-formula',
      `= ${won.format(cashOnHand)} − ${won.format(jeonseDeposit)} − ${won.format(r.jeonse.brokerageFee)}`,
    );

    setSignedWon('jeonse-surplus-return', r.jeonse.surplusInvestReturn, '+');
    setText(
      'jeonse-surplus-return-formula',
      `= ${won.format(r.jeonse.surplusCash)} × ((1+${fmtPct(investReturnRatePercent)})^${years} − 1)`,
    );

    setWon('jeonse-final-deposit', r.jeonse.expectedFinalDeposit);
    setText(
      'jeonse-final-deposit-formula',
      `= ${won.format(jeonseDeposit)} × (1+${fmtPct(jeonseRenewalIncreasePercent)})^${r.jeonse.renewalCycles}`,
    );

    setWon('jeonse-final-capital', r.jeonse.finalCapital);
    setText(
      'jeonse-final-capital-formula',
      `= ${won.format(r.jeonse.startingCash)} + ${won.format(r.jeonse.surplusInvestReturn)} − ${won.format(r.jeonse.brokerageFee)}`,
    );

    result.classList.remove('hidden');
  });
</script>
