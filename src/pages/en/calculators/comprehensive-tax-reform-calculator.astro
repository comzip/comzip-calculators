---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import RelatedCalculators from '../../../components/RelatedCalculators.astro';
import { calculators } from '../../../data/calculators';

const meta = calculators.find((c) => c.slug === 'comprehensive-tax-reform-calculator')!;
---

<BaseLayout
  title={meta.titleEn}
  description={meta.descriptionEn}
  path={`/calculators/${meta.slug}`}
  lang="en"
>
  <div class="proposal-banner">
    <p class="lead">⚠️ This calculator is not law yet</p>
    <p>
      This tool previews the comprehensive real estate tax reform direction announced by Korea's
      Ministry of Economy and Finance on August 3, 2026 (the <strong>"2026 Tax Reform
      Proposal"</strong>). It still needs to go through pre-announcement, cabinet approval,
      submission to and passage by the National Assembly, and promulgation — the details may
      change or the proposal may be scrapped entirely during legislative review.
    </p>
    <ol class="progress-steps">
      <li>Pre-announcement</li>
      <li>Cabinet meeting</li>
      <li>National Assembly</li>
      <li>Enactment</li>
    </ol>
    <p class="banner-link">
      To calculate under confirmed current law instead →
      <a href="/en/calculators/property-tax-calculator/">Property Holding Tax Calculator</a>
      · Curious about the capital gains tax reform too? →
      <a href="/en/calculators/capital-gains-tax-reform-calculator/">Capital Gains Reform Preview</a>
    </p>
  </div>

  <h1>{meta.titleEn}</h1>
  <p class="note">
    This calculator covers <strong>comprehensive real estate tax only</strong> — no evidence was
    found that property tax (local tax) changes under this proposal. For property tax, use the
    existing <a href="/en/calculators/property-tax-calculator/">Property Holding Tax
    Calculator</a>.
  </p>

  <form class="calc-form" id="reform-form">
    <fieldset class="method-toggle stacked-options">
      <legend>Select Year (Reform Implementation Stage)</legend>
      <label class="method-option">
        <input type="radio" name="year" value="2026" checked />
        <span>2026<br /><small class="hint">Current law (proposal not yet applied)</small></span>
      </label>
      <label class="method-option">
        <input type="radio" name="year" value="2027" />
        <span>2027<br /><small class="hint">Stage 1: deduction &amp; ratio changes (house-count tiers remain)</small></span>
      </label>
      <label class="method-option">
        <input type="radio" name="year" value="2028" />
        <span>2028<br /><small class="hint">Stage 2: unified value-based rates</small></span>
      </label>
      <label class="method-option">
        <input type="radio" name="year" value="2029" />
        <span>2029<br /><small class="hint">Same as 2028 (no rate/ratio change)</small></span>
      </label>
    </fieldset>

    <label>
      Total Announced Value of All Homes Held (KRW)
      <span class="hint">Sum of announced values for all homes you own. e.g. 2000000000</span>
      <input
        type="number"
        id="totalPublicPrice"
        name="totalPublicPrice"
        min="0"
        step="any"
        placeholder="e.g. 2000000000"
        required
      />
      <span class="amount-preview" id="totalPublicPrice-preview" aria-live="polite"></span>
    </label>

    <label>
      Number of Homes
      <select id="houseCount">
        <option value="1주택">1 home (1 household, 1 home)</option>
        <option value="2주택">2 homes</option>
        <option value="3주택이상">3+ homes</option>
      </select>
    </label>

    <fieldset class="method-toggle" id="residency-options">
      <legend>Owner-Occupied? <span class="hint">(affects the 1-household-1-home deduction)</span></legend>
      <label class="method-option">
        <input type="radio" name="residency" value="실거주" checked />
        <span>Owner-occupied</span>
      </label>
      <label class="method-option">
        <input type="radio" name="residency" value="비거주" />
        <span>Not owner-occupied</span>
      </label>
    </fieldset>

    <label class="check-row" id="regulated-area-options">
      <input type="checkbox" id="isRegulatedArea" />
      <span>Located in a regulated area (affects fair market value ratio from 2028 onward)</span>
    </label>
    <p class="note hidden" id="regulated-area-note"></p>

    <label id="residential-home-value-options">
      Announced Value of the Home You Actually Live In (KRW)
      <span class="hint">
        (optional) If you own 2+ homes and live in one of them, its announced value. Leave blank if
        you don't live in any of them — the multi-home deduction is "₩400 million + ₩500 million ×
        (value of the home you live in ÷ total announced value)"; with none, only ₩400 million
        applies.
      </span>
      <input
        type="number"
        id="residentialHomeValue"
        name="residentialHomeValue"
        min="0"
        step="any"
        placeholder="e.g. 800000000"
      />
      <span class="amount-preview" id="residentialHomeValue-preview" aria-live="polite"></span>
    </label>

    <div id="senior-longterm-options">
      <label>
        Age (years) <span class="hint">(optional, for elderly tax credit — 1 household, 1 home only)</span>
        <input type="number" id="age" name="age" min="0" step="1" placeholder="e.g. 68" />
      </label>
      <label>
        Holding Period (years)
        <span class="hint">
          (optional) Applies to the 2026 (current law) result and to 2027 (compared against
          residency period — whichever gives the larger credit is used).
        </span>
        <input type="number" id="holdingYears" name="holdingYears" min="0" step="1" placeholder="e.g. 12" />
      </label>
      <label>
        Residency Period (years)
        <span class="hint">
          (optional) Applies to 2027 (compared against holding period) and from 2028 onward (only
          the residency credit is recognized).
        </span>
        <input type="number" id="residencyYears" name="residencyYears" min="0" step="1" placeholder="e.g. 8" />
      </label>
    </div>

    <button class="btn" type="submit">Calculate</button>
  </form>

  <p class="note" id="reform-error" role="alert"></p>

  <div class="result-box hidden" id="reform-result" aria-live="polite">
    <table class="breakdown">
      <caption class="note" style="text-align:left;margin-bottom:6px;">
        Breakdown for Selected Year
      </caption>
      <tbody>
        <tr>
          <td>
            Deduction
            <span class="formula-line" id="rt-deduction-line">-</span>
            <span class="formula-actual" id="rt-deduction-formula">-</span>
          </td>
          <td id="rt-deduction">-</td>
        </tr>
        <tr>
          <td>
            Fair Market Value Ratio
            <span class="formula-line" id="rt-fmv-line">-</span>
            <span class="formula-actual" id="rt-fmv-formula">-</span>
          </td>
          <td id="rt-fmv">-</td>
        </tr>
        <tr>
          <td>
            Tax Base
            <span class="formula-line">= max(0, total announced value − deduction) × fair market value ratio</span>
            <span class="formula-actual" id="rt-taxbase-formula">-</span>
          </td>
          <td id="rt-taxbase">-</td>
        </tr>
        <tr>
          <td>
            Calculated Tax <span class="hint" id="rt-status-badge"></span>
            <span class="formula-line" id="rt-tax-line">-</span>
            <span class="formula-actual" id="rt-tax-formula">-</span>
          </td>
          <td id="rt-tax">-</td>
        </tr>
        <tr>
          <td>
            Property Tax Credit <span class="hint">(double taxation adjustment, approximate)</span>
            <span class="formula-line" id="rt-property-credit-line">-</span>
            <span class="formula-actual" id="rt-property-credit-formula">-</span>
          </td>
          <td id="rt-property-credit">-</td>
        </tr>
        <tr id="rt-credit-row" class="hidden">
          <td>
            Tax Credit <span class="hint" id="rt-credit-label"></span>
            <span class="formula-line">= (calculated tax − property tax credit) × credit rate (age + holding/residency, capped)</span>
            <span class="formula-actual" id="rt-credit-formula">-</span>
          </td>
          <td id="rt-credit">-</td>
        </tr>
        <tr class="total">
          <td>
            Final Tax
            <span class="formula-line">= calculated tax − property tax credit − tax credit</span>
            <span class="formula-actual" id="rt-final-formula">-</span>
          </td>
          <td id="rt-final">-</td>
        </tr>
        <tr>
          <td>
            Special Rural Development Tax <span class="hint">(20% of final tax)</span>
            <span class="formula-actual" id="rt-rural-formula">-</span>
          </td>
          <td id="rt-rural">-</td>
        </tr>
        <tr class="total">
          <td>
            Total
            <span class="formula-line">= final tax + rural development tax</span>
            <span class="formula-actual" id="rt-total-formula">-</span>
          </td>
          <td id="rt-total">-</td>
        </tr>
      </tbody>
    </table>

    <p class="note" style="text-align:left;margin-bottom:6px;">Year-by-Year Comparison (same inputs)</p>
    <div class="table-scroll">
    <table class="breakdown" id="year-compare-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>2026</th>
          <th>2027</th>
          <th>2028</th>
          <th>2029</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Deduction</td>
          <td id="cmp-deduction-2026">-</td>
          <td id="cmp-deduction-2027">-</td>
          <td id="cmp-deduction-2028">-</td>
          <td id="cmp-deduction-2029">-</td>
        </tr>
        <tr>
          <td>Fair Market Value Ratio</td>
          <td id="cmp-fmv-2026">-</td>
          <td id="cmp-fmv-2027">-</td>
          <td id="cmp-fmv-2028">-</td>
          <td id="cmp-fmv-2029">-</td>
        </tr>
        <tr class="total">
          <td>Total <span class="hint">(incl. rural tax)</span></td>
          <td id="cmp-final-2026">-</td>
          <td id="cmp-final-2027">-</td>
          <td id="cmp-final-2028">-</td>
          <td id="cmp-final-2029">-</td>
        </tr>
      </tbody>
    </table>
    </div>

    <div class="disclaimer strong-disclaimer">
      <strong>Limitations of this calculator</strong>
      <ul>
        <li>
          <strong>Property tax credit (double taxation adjustment)</strong> follows the statutory
          formula. It's exact for single-home owners, but for <strong>multi-home</strong> owners
          this calculator only takes the <em>combined</em> announced value, so it assumes each home
          is worth ₩500 million or more — if any home falls below that, results may differ. "3+
          homes" is computed as exactly 3, so with 4 or more homes your actual tax is
          <strong>slightly higher</strong> than shown.
        </li>
        <li>
          <strong>Tax burden ceiling</strong> (proposed to rise from 150% to 200%) is not
          reflected — same reason as the existing calculator: no prior-year paid-tax data is
          available.
        </li>
        <li>
          Tax credits (age / holding / residency) apply <strong>only to 1-household-1-home
          owners</strong>. The proposal doesn't mention a separate credit for multi-home owners.
        </li>
      </ul>
    </div>
  </div>

  <div class="disclaimer">
    This result is a simulation based on <strong>a government proposal that has not yet been
    enacted</strong>, and may differ from the actual outcome. Always verify whether the bill
    passed the National Assembly and check its final text.
  </div>

  <section class="law-refs">
    <h2>Sources (Government Proposal — Not Statute)</h2>
    <ul>
      <li>
        <a
          href="https://www.mofe.go.kr/nw/mosfnw/detailInfograpView.do?searchNttId1=MOSF_000000000078819&menuNo=4040500"
          target="_blank"
          rel="noopener noreferrer">Korea's Ministry of Economy and Finance — official "2026 Tax Reform" infographic (primary source)</a
        >
      </li>
      <li>
        <a
          href="https://www.mofe.go.kr/nw/nes/detailNesDtaView.do?searchBbsId1=MOSFBBS_000000000028&searchNttId1=MOSF_000000000078809&menuNo=4010100"
          target="_blank"
          rel="noopener noreferrer">Ministry of Economy and Finance — "2026 Tax Reform" press release and detailed PDF</a
        >
      </li>
      <li>
        <a href="https://www.newspim.com/news/view/20260803001172" target="_blank" rel="noopener noreferrer"
          >Newspim — Comprehensive tax unified by 2028, capital gains tax residency credit by 2029 (staging, cross-check)</a
        >
      </li>
      <li>
        <a href="https://www.tfmedia.co.kr/news/article.html?no=206204" target="_blank" rel="noopener noreferrer"
          >Tax & Finance Media — Staged 2027/2028 rate and tax-credit changes (cross-check)</a
        >
      </li>
    </ul>
  </section>

  <AdSlot lang="en" />

  <RelatedCalculators slug="comprehensive-tax-reform-calculator" lang="en" />

  <section class="faq">
    <h2>Frequently Asked Questions</h2>

    <details>
      <summary>Is this calculator based on enacted law?</summary>
      <p>
        No. This reflects a tax reform proposal announced by Korea's Ministry of Economy and
        Finance on August 3, 2026. It still needs to go through pre-announcement, cabinet
        approval, and National Assembly review and passage. Specific figures may change, or the
        proposal itself may be scrapped, during legislative review.
      </p>
    </details>

    <details>
      <summary>Why does 2026 come out identical to current law?</summary>
      <p>
        Comprehensive real estate tax is assessed based on home ownership as of June 1 each year,
        and this proposal was announced afterward, on August 3, 2026. So the 2026 tax year is
        unaffected by this proposal and is calculated exactly as under current law.
      </p>
    </details>

    <details>
      <summary>Why does 2027 use a different rate table for 3+ homes?</summary>
      <p>
        The house-count-based rate tiers don't fully disappear until 2028. In 2027, only 1- and
        2-home owners get the new rate table (0.5%–3.5%); owners of 3 or more homes are still
        taxed under the current-law rate table (e.g. 1.0% for the ₩600M–₩1.2B band) even in 2027.
        This calculator reflects that distinction — selecting 3+ homes uses the current-law table
        for 2027 as well.
      </p>
    </details>

    <details>
      <summary>How is the multi-home deduction calculated?</summary>
      <p>
        ₩400 million, plus ₩500 million multiplied by "announced value of the home you live in ÷
        total announced value of all your homes." So if you don't live in any of your homes, only
        ₩400 million applies; if effectively all your property value is concentrated in the one
        home you live in, it can rise to as much as ₩900 million (the same amount as today's flat
        multi-home deduction).
      </p>
    </details>

    <details>
      <summary>What's the dollar cap on the 1-household-1-home tax credit?</summary>
      <p>
        The combined age + holding/residency credit rate is still capped at 80%, same as today, but
        a new absolute cap is added on top: ₩8 million in 2027, and ₩6 million from 2028 onward. If
        the calculated credit exceeds that amount, only the cap applies.
      </p>
    </details>

    <details>
      <summary>Does this proposal also affect property tax?</summary>
      <p>
        No evidence was found in reporting on this proposal that property tax (local tax)
        changes. This calculator covers comprehensive real estate tax (national tax) only —
        for property tax, continue using the existing
        <a href="/en/calculators/property-tax-calculator/">Property Holding Tax Calculator</a>.
      </p>
    </details>
  </section>
</BaseLayout>

<style>
  .proposal-banner {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .proposal-banner .lead {
    margin: 0 0 6px;
    font-weight: 700;
    font-size: 1.05rem;
    color: #b91c1c;
  }
  .proposal-banner p {
    margin: 6px 0;
    font-size: 0.92rem;
  }
  .progress-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b91c1c;
  }
  .progress-steps li {
    background: #fff;
    border: 1px solid #fca5a5;
    border-radius: 999px;
    padding: 3px 10px;
  }
  .progress-steps li:not(:last-child)::after {
    content: '→';
    margin-left: 8px;
    color: #b91c1c;
  }
  .banner-link {
    font-weight: 600;
  }

  .calc-form .method-toggle.stacked-options .method-option small {
    font-weight: 400;
  }
  #senior-longterm-options {
    display: grid;
    gap: 16px;
  }

  .law-refs {
    margin: 24px 0;
  }
  .law-refs h2 {
    font-size: 1.05rem;
  }
  .law-refs ul {
    margin: 8px 0;
    padding-left: 20px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .law-refs li {
    margin: 6px 0;
  }
  .strong-disclaimer {
    background: #fef2f2;
    border-color: #fca5a5;
    color: var(--text);
    margin-top: 16px;
  }
  .strong-disclaimer ul {
    margin: 8px 0;
    padding-left: 20px;
  }
  .strong-disclaimer li {
    margin: 4px 0;
  }
  .table-scroll {
    overflow-x: auto;
  }
  #year-compare-table {
    min-width: 480px;
  }
  #year-compare-table td,
  #year-compare-table th {
    white-space: nowrap;
  }
  #year-compare-table td:not(:first-child),
  #year-compare-table th:not(:first-child) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* formula-line/formula-actual pattern — shows the general formula and the
     actual substituted numbers side by side for each result row. Follows the
     pattern introduced in buy-vs-jeonse-calculator.astro/
     stock-averaging-calculator.astro (not yet promoted to BaseLayout global
     CSS, see CLAUDE.md). */
  table.breakdown .hint,
  table.breakdown .formula-line,
  table.breakdown .formula-actual {
    display: block;
    font-weight: 400;
    color: var(--text-muted);
  }
  table.breakdown .hint {
    font-size: 0.85rem;
    margin-top: 2px;
  }
  table.breakdown .formula-line,
  table.breakdown .formula-actual {
    font-size: 0.78rem;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import {
    calculateReformTax,
    calculateReformTaxAllYears,
  } from '../../../lib/comprehensiveTaxReformCalculator';
  import type { ReformYear, ResidencyStatus } from '../../../lib/comprehensiveTaxReformCalculator';
  import type { HouseCount } from '../../../lib/propertyTaxCalculator';
  import { formatWonEn } from '../../../lib/formatKoreanWon';

  const bindAmountPreview = (inputId: string, previewId: string) => {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const preview = document.getElementById(previewId) as HTMLSpanElement;
    input.addEventListener('input', () => {
      const value = Number(input.value);
      preview.textContent = value > 0 ? formatWonEn(value) : '';
    });
  };
  bindAmountPreview('totalPublicPrice', 'totalPublicPrice-preview');
  bindAmountPreview('residentialHomeValue', 'residentialHomeValue-preview');

  const won = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'KRW',
    maximumFractionDigits: 0,
  });
  const setWon = (id: string, value: number) => {
    const el = document.getElementById(id);
    if (el) el.textContent = won.format(Math.round(value));
  };
  const setText = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };
  const pct = (ratio: number) => `${(ratio * 100).toFixed(0)}%`;
  // pct()'s integer rounding is too coarse for formula display (0.5%, 1.3%,
  // 43-45%, etc.), so formula-actual text uses two decimal places instead.
  const fmtPct2 = (ratio: number) => `${Number((ratio * 100).toFixed(2))}%`;

  const form = document.getElementById('reform-form') as HTMLFormElement;
  const resultBox = document.getElementById('reform-result') as HTMLDivElement;
  const errorEl = document.getElementById('reform-error') as HTMLParagraphElement;

  const houseCountSelect = document.getElementById('houseCount') as HTMLSelectElement;
  const residencyOptions = document.getElementById('residency-options') as HTMLFieldSetElement;
  const regulatedAreaOptions = document.getElementById('regulated-area-options') as HTMLLabelElement;
  const regulatedAreaNote = document.getElementById('regulated-area-note') as HTMLParagraphElement;
  const isRegulatedAreaInput = document.getElementById('isRegulatedArea') as HTMLInputElement;
  const residentialHomeValueOptions = document.getElementById(
    'residential-home-value-options',
  ) as HTMLLabelElement;
  const seniorLongtermOptions = document.getElementById('senior-longterm-options') as HTMLDivElement;

  // Residency and the age/holding/residency tax credit inputs only matter for
  // 1 home; the residential-home-value input only matters for multi-home
  // owners; regulated-area status only matters for 2 homes — the other cases
  // always use a fixed track (1 home = A, 3+ homes = B), so show an
  // explanatory note instead of the input.
  const syncHouseCountOptions = () => {
    const houseCount = houseCountSelect.value as HouseCount;
    residencyOptions.classList.toggle('hidden', houseCount !== '1주택');
    seniorLongtermOptions.classList.toggle('hidden', houseCount !== '1주택');
    residentialHomeValueOptions.classList.toggle('hidden', houseCount === '1주택');
    regulatedAreaOptions.classList.toggle('hidden', houseCount !== '2주택');
    if (houseCount === '1주택') {
      regulatedAreaNote.classList.add('hidden');
    } else if (houseCount === '3주택이상') {
      regulatedAreaNote.textContent =
        '3+ homes always use the higher fair market value ratio (80% from 2028) regardless of area.';
      regulatedAreaNote.classList.remove('hidden');
    } else {
      regulatedAreaNote.classList.add('hidden');
    }
  };
  houseCountSelect.addEventListener('change', syncHouseCountOptions);
  syncHouseCountOptions();

  const currentYear = (): ReformYear =>
    Number(
      (form.querySelector('input[name="year"]:checked') as HTMLInputElement).value,
    ) as ReformYear;

  const recalc = () => {
    errorEl.textContent = '';

    const totalPublicPrice = Number(
      (document.getElementById('totalPublicPrice') as HTMLInputElement).value,
    );
    if (!totalPublicPrice || totalPublicPrice <= 0) {
      resultBox.classList.add('hidden');
      errorEl.textContent = 'Please enter a valid total announced value for your homes.';
      return;
    }

    const houseCount = houseCountSelect.value as HouseCount;
    const residency = (
      form.querySelector('input[name="residency"]:checked') as HTMLInputElement | null
    )?.value as ResidencyStatus | undefined;
    const isRegulatedArea = isRegulatedAreaInput.checked;
    const residentialHomeValue = Number(
      (document.getElementById('residentialHomeValue') as HTMLInputElement).value,
    );
    const age = Number((document.getElementById('age') as HTMLInputElement).value);
    const holdingYears = Number(
      (document.getElementById('holdingYears') as HTMLInputElement).value,
    );
    const residencyYears = Number(
      (document.getElementById('residencyYears') as HTMLInputElement).value,
    );
    // The elderly credit only needs age — holding/residency period only
    // matter for years that use them, so leaving either blank must not drop
    // the age-based credit.
    const ageAndHolding = age > 0
      ? { age, holdingYears: holdingYears > 0 ? holdingYears : 0, residencyYears: residencyYears > 0 ? residencyYears : 0 }
      : undefined;

    const commonInput = {
      totalPublicPrice,
      houseCount,
      residency,
      isRegulatedArea,
      residentialHomeValue: residentialHomeValue > 0 ? residentialHomeValue : undefined,
      ageAndHolding,
    };

    const year = currentYear();
    const result = calculateReformTax({ ...commonInput, year });

    setWon('rt-deduction', result.deduction);
    setText('rt-fmv', pct(result.fairMarketRatio));
    setWon('rt-taxbase', result.taxBase);
    setWon('rt-tax', result.bracket.calculatedTax);

    const statusBadge = result.bracket.status === 'delegated' ? '(delegated to current law)' : '(confirmed bracket)';
    setText('rt-status-badge', statusBadge);

    // The deduction formula itself differs by year and by 1-home vs
    // multi-home, so the formula-line text switches to match what was
    // actually applied.
    if (year === 2026) {
      setText('rt-deduction-line', '= flat deduction under current law (Comprehensive Real Estate Tax Act §8), delegated');
      setText('rt-deduction-formula', `= ${won.format(result.deduction)}`);
    } else if (houseCount === '1주택') {
      setText('rt-deduction-line', '= flat deduction (₩1.4B owner-occupied / ₩900M not occupied)');
      setText(
        'rt-deduction-formula',
        `= ${residency === '비거주' ? '₩900M (not occupied)' : '₩1.4B (owner-occupied)'} applied → ${won.format(result.deduction)}`,
      );
    } else {
      setText('rt-deduction-line', '= ₩400M + ₩500M × (value of home you live in ÷ total announced value)');
      const homeValue = residentialHomeValue > 0 ? residentialHomeValue : 0;
      setText(
        'rt-deduction-formula',
        `= ${won.format(400_000_000)} + ${won.format(500_000_000)} × (${won.format(homeValue)} ÷ ${won.format(totalPublicPrice)}) = ${won.format(result.deduction)}`,
      );
    }

    // The fair market value ratio's formula also differs by year/track — 2027
    // has no track distinction at all, and only 2028+ apply track A/B.
    if (year === 2026) {
      setText('rt-fmv-line', '= fixed ratio under current law');
      setText('rt-fmv-formula', `= ${fmtPct2(result.fairMarketRatio)}`);
    } else if (year === 2027) {
      setText('rt-fmv-line', '= 2027, single ratio regardless of home count or area');
      setText('rt-fmv-formula', `= ${fmtPct2(result.fairMarketRatio)}`);
    } else {
      setText('rt-fmv-line', '= 2028 onward, fixed ratio by track (Track A 70% / Track B 80%)');
      const trackLabel =
        result.fmvTrack === 'B' ? 'Track B (regulated-area 2 homes · 3+ homes)' : 'Track A (1 home · non-regulated 2 homes)';
      setText('rt-fmv-formula', `= ${trackLabel} → ${fmtPct2(result.fairMarketRatio)}`);
    }

    setText(
      'rt-taxbase-formula',
      `= max(0, ${won.format(totalPublicPrice)} − ${won.format(result.deduction)}) × ${fmtPct2(result.fairMarketRatio)} = ${won.format(result.taxBase)}`,
    );

    setText(
      'rt-tax-line',
      result.bracket.status === 'delegated'
        ? '= current law (Comprehensive Real Estate Tax Act §8) rate table applied as-is (delegated)'
        : '= tax base × year-specific progressive rate table',
    );
    const effectiveTaxRate = result.taxBase > 0 ? (result.bracket.calculatedTax / result.taxBase) * 100 : 0;
    setText(
      'rt-tax-formula',
      `tax base ${won.format(result.taxBase)} → calculated tax ${won.format(result.bracket.calculatedTax)} (effective rate ${Number(effectiveTaxRate.toFixed(2))}%)`,
    );

    // The property tax credit is exact for 1-home owners, but for multi-home
    // owners it also folds in a split-adjustment ratio driven by property
    // tax's progressive structure — that internal ratio isn't exposed by this
    // calculator's result, so here we show only which rule applied and the
    // exact input → output relationship.
    setText(
      'rt-property-credit-line',
      houseCount === '1주택'
        ? '= tax base × property tax special ratio for 1-home owners (43-45%) × top property tax rate (0.4%)'
        : '= tax base × property tax ratio (60%) × top rate (0.4%) × multi-home split-adjustment ratio (approximate)',
    );
    setText(
      'rt-property-credit-formula',
      `based on tax base ${won.format(result.taxBase)}, ${houseCount === '1주택' ? 'exact value' : 'approximate value'} → ${won.format(result.propertyTaxCredit)}`,
    );

    const creditRow = document.getElementById('rt-credit-row') as HTMLTableRowElement;
    creditRow.classList.toggle('hidden', result.creditAmount <= 0);
    if (result.creditAmount > 0) {
      setWon('rt-credit', result.creditAmount);
      const creditLabel =
        result.year === 2026
          ? 'age + long-term holding credit, current law'
          : result.year === 2027
            ? 'age credit + better of holding/residency credit, proposal (₩8M cap)'
            : 'age + residency credit, proposal (₩6M cap)';
      setText('rt-credit-label', `(${creditLabel}, nominal ${pct(result.creditRate)})`);

      const afterPropertyCredit = Math.max(0, result.bracket.calculatedTax - result.propertyTaxCredit);
      const nominalCreditAmount = afterPropertyCredit * result.creditRate;
      const isCapped = nominalCreditAmount > result.creditAmount + 1;
      setText(
        'rt-credit-formula',
        isCapped
          ? `= (${won.format(afterPropertyCredit)} × ${fmtPct2(result.creditRate)} = ${won.format(nominalCreditAmount)}) → cap applied → ${won.format(result.creditAmount)}`
          : `= ${won.format(afterPropertyCredit)} × ${fmtPct2(result.creditRate)} = ${won.format(result.creditAmount)}`,
      );
    }

    setWon('rt-property-credit', result.propertyTaxCredit);
    setWon('rt-final', result.finalTax);
    setText(
      'rt-final-formula',
      `= ${won.format(result.bracket.calculatedTax)} − ${won.format(result.propertyTaxCredit)} − ${won.format(result.creditAmount)} = ${won.format(result.finalTax)}`,
    );
    setWon('rt-rural', result.ruralSpecialTax);
    setText('rt-rural-formula', `= ${won.format(result.finalTax)} × 20% = ${won.format(result.ruralSpecialTax)}`);
    setWon('rt-total', result.totalWithSurtax);
    setText(
      'rt-total-formula',
      `= ${won.format(result.finalTax)} + ${won.format(result.ruralSpecialTax)} = ${won.format(result.totalWithSurtax)}`,
    );

    // The comparison table's bottom row must show the same figure as the
    // detail table's bottom row ("Total") — this row used to show 결정세액
    // (excluding the rural surtax), so the same year read differently in the
    // two tables.
    const allYears = calculateReformTaxAllYears(commonInput);
    for (const y of [2026, 2027, 2028, 2029] as const) {
      const r = allYears[y];
      setWon(`cmp-deduction-${y}`, r.deduction);
      setText(`cmp-fmv-${y}`, pct(r.fairMarketRatio));
      setWon(`cmp-final-${y}`, r.totalWithSurtax);
    }

    resultBox.classList.remove('hidden');
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    recalc();
  });
</script>
