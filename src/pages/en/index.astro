---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import { calculators, categoryOrder, categoryLabels } from '../../data/calculators';

// See ko/index.astro for the rationale — same hardcoded-list banner, mirrored
// here for the English homepage.
const featuredSlugs = ['comprehensive-tax-reform-calculator', 'capital-gains-tax-reform-calculator'];
const featuredCalculators = featuredSlugs
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);
---

<BaseLayout title="Comzip Calculators" path="/" lang="en">
  <section class="intro">
    <h1>Everyday Calculators</h1>
    <p>
      Checking your pay stub, deciding whether to buy or rent, timing an
      investment — instead of searching for a different calculator every
      time, we've put the money math you run into day to day in one place.
      No sign-up, no installation: everything runs in your browser, and the
      range of what we cover keeps growing.
    </p>
  </section>

  <div class="filter-bar">
    <select id="categorySelect" aria-label="Select category">
      <option value="전체">All categories</option>
      {categoryOrder.map((category) => <option value={category}>{categoryLabels[category].en}</option>)}
    </select>
    <input
      type="search"
      id="searchInput"
      placeholder="Search calculators (e.g. acquisition tax, salary, averaging...)"
      aria-label="Search calculators"
    />
  </div>

  {featuredCalculators.map((calculator) => (
    <a class="hot-banner" href={`/en/calculators/${calculator.slug}/`}>
      <span class="hot-badge">🔥 Trending Calculator</span>
      <h2>{calculator.titleEn}</h2>
      <p>{calculator.descriptionEn}</p>
    </a>
  ))}

  <p class="result-count" id="resultCount"></p>

  <div class="card-grid" id="grid">
    {calculators.map((calculator) => <CalculatorCard calculator={calculator} lang="en" />)}
  </div>
  <p class="empty-state" id="emptyState">No calculators match. Try a different search term or category.</p>
</BaseLayout>

<style>
  .hot-banner {
    display: block;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg));
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-top: 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .hot-banner:hover {
    border-color: var(--accent);
  }
  .hot-banner .hot-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent-dark);
    background: var(--bg-soft);
    border-radius: 5px;
    padding: 2px 8px;
    margin-bottom: 8px;
  }
  .hot-banner h2 {
    margin: 0 0 6px;
    font-size: 1.1rem;
    color: var(--accent-dark);
  }
  .hot-banner p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .intro h1 {
    font-size: 1.6rem;
    margin: 8px 0 12px;
  }
  .intro p {
    color: var(--text-muted);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .filter-bar select,
  .filter-bar input[type='search'] {
    font: inherit;
    font-size: 0.92rem;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .filter-bar select {
    flex: 0 0 auto;
    min-width: 132px;
    font-weight: 600;
    color: var(--accent-dark);
  }
  .filter-bar input[type='search'] {
    flex: 1 1 220px;
    min-width: 0;
  }
  .result-count {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .result-count strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .card-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-top: 12px;
  }
  .empty-state {
    display: none;
    padding: 40px 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .empty-state.show {
    display: block;
  }
  .card-grid.hidden-by-empty {
    display: none;
  }
</style>

<script>
  const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const grid = document.getElementById('grid') as HTMLDivElement;
  const resultCount = document.getElementById('resultCount') as HTMLParagraphElement;
  const emptyState = document.getElementById('emptyState') as HTMLParagraphElement;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.calc-card'));

  const render = () => {
    const category = categorySelect.value;
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory = category === '전체' || card.dataset.category === category;
      const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
      const visible = matchesCategory && matchesQuery;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    resultCount.innerHTML = `Showing <strong>${visibleCount}</strong> of <strong>${cards.length}</strong> calculators`;
    emptyState.classList.toggle('show', visibleCount === 0);
    grid.classList.toggle('hidden-by-empty', visibleCount === 0);
  };

  categorySelect.addEventListener('change', render);
  searchInput.addEventListener('input', render);
  render();
</script>
